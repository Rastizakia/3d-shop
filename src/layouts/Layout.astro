---
import '../styles/global.css';

const { title } = Astro.props;
const facebookUrl = "https://www.facebook.com/groups/1164649835737765";

// This checks which page is active to highlight the button
const pathname = new URL(Astro.request.url).pathname;
const currentPath = pathname.slice(1); // remove the first "/"
---

<html lang="bg" data-theme="dark">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>{title} | 3D Print Burgas</title>
</head>
<body class="bg-base-200 min-h-screen flex flex-col">

    <!-- NAVBAR -->
    <div class="navbar bg-base-100 shadow-lg sticky top-0 z-50">
        <div class="navbar-start">
            <div class="dropdown">
                <div tabindex="0" role="button" class="btn btn-ghost lg:hidden">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h8m-8 6h16" /></svg>
                </div>
                <ul tabindex="0" class="menu menu-sm dropdown-content mt-3 z-[1] p-2 shadow bg-base-100 rounded-box w-52">
                    <li><a href="/3d-shop/">Начало</a></li>
                    <li><a href="/3d-shop/gallery">Галерия</a></li>
                </ul>
            </div>
            <a href="/" class="btn btn-ghost text-xl font-bold text-primary">🎁 3Д Принт Подаръци</a>
        </div>
        <div class="navbar-center hidden lg:flex">
            <ul class="menu menu-horizontal px-1 gap-2">
                <li><a href="/3d-shop/" class={currentPath === "" ? "active font-bold" : ""}>Начало</a></li>
                <li><a href="/3d-shop/gallery" class={currentPath === "/3d-shop/gallery" ? "active font-bold" : ""}>Галерия</a></li>
            </ul>
        </div>
        <div class="navbar-end">
            <a href={facebookUrl} target="_blank" class="btn btn-primary btn-sm">
                Свържи се с нас
            </a>
        </div>
    </div>

    <!-- MAIN CONTENT (Where the page specific stuff goes) -->
    <slot />

    <!-- FOOTER -->
    <footer class="footer items-center p-4 bg-neutral text-neutral-content mt-auto">
        <aside class="items-center grid-flow-col">
            <p>Изработено с ❤️ в Бургас. Copyright © {new Date().getFullYear()}</p>
        </aside> 
        <nav class="grid-flow-col gap-4 md:place-self-center md:justify-self-end">
            <a href={facebookUrl} class="link link-hover">Facebook</a>
        </nav>
    </footer>

</body>
</html>