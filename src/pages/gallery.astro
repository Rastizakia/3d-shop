---

<Layout title="Галерия">
    <div class="container mx-auto px-4 py-10">
        <h1 class="text-4xl font-bold text-center mb-2">Нашите Продукти</h1>
        <p class="text-center opacity-70 mb-10">Разгледайте всичко, което сме изработили до момента.</p>

        <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-6">
            {allProducts.map((item) => (
                <div class="card bg-base-100 shadow-lg hover:shadow-xl transition-all">
                    <figure class="h-64 w-full overflow-hidden">
                         {/* We give the image a specific class for our style block to target */}
                         <img src={item.image} alt={item.title} class="gallery-card-image" />
                    </figure>
                    <div class="card-body p-4">
                        <div class="flex justify-between items-start gap-2 flex-nowrap">
                            <h2 class="card-title text-lg font-bold whitespace-nowrap overflow-hidden text-ellipsis flex-shrink">{item.title}</h2>
                            <div class="badge badge-accent text-xs font-bold flex-shrink-0">{item.price}</div>
                        </div>
                        <p class="text-sm opacity-60 mb-2">{item.category}</p>
                        <div class="card-actions justify-end">
                            <a href="https://www.facebook.com/groups/1164649835737765" 
                               target="_blank" 
                               class="btn btn-primary btn-sm w-full">
                               Поръчай
                            </a>
                        </div>
                    </div>
                </div>
            ))}
        </div>
    </div>
</Layout>

<!-- This style block will force the images to cover their containers -->
<style is:global>
    .gallery-card-image {
        width: 100%;
        height: 100%;
        object-fit: cover !important; /* Forces the image to cover the space */
        object-position: center !important; /* Ensures the image is centered */
    }
</style>